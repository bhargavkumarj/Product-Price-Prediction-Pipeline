# Curated dataset: a HuggingFace name, or a local folder written by `run.py curate`
PRICER_DATASET=ed-donner/items_lite

# Rewrites raw listings into short comparable summaries (any LiteLLM model)
SUMMARISER_MODEL=groq/openai/gpt-oss-20b

# Zero-shot pricing model for the `frontier` predictor
FRONTIER_MODEL=openai/gpt-4.1-mini

OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# ANTHROPIC_API_KEY=sk-ant-...
# HF_TOKEN=hf_...          # needed to push a curated dataset to the Hub
